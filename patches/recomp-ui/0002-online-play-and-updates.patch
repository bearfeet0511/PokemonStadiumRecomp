@@ -1445,7 +1535,36 @@ void panel_controller_draw(LauncherModel* m, const LauncherTheme* th) {
 // (SAVES only when the game has SRAM, folded into the GAME card — see
 // draw_save_row). A different system's profile simply contributes a
 // different panel list.
+// "Update available" banner across the top of the dashboard, while the host's
+// update_notice callback reports a newer release (and the player hasn't turned
+// update checks off).
+void draw_update_banner(LauncherModel* m, const LauncherTheme& th) {
+    if (!m->update_notice_cb || m->s.no_update_check) return;
+    char text[200], url[256];
+    const int state = m->update_notice_cb(text, sizeof(text), url, sizeof(url));
+    if (state == 0) return;
+    if (!begin_panel("update", 0, false)) { end_panel(); return; }
+    const float bw = px(120);
+    const bool can_update = state == 1 && m->start_update_cb;
+    const bool show_page = state != 2 && m->open_url_cb;
+    const int buttons = (can_update ? 1 : 0) + (show_page ? 1 : 0);
+    const float buttons_w = buttons * bw + (buttons > 1 ? px(th.spacing_sm) : 0.0f);
+    ImGui::AlignTextToFramePadding();
+    ImGui::TextColored(state == 3 ? col(th.accent) : col(th.warn), "%s", text);
+    if (buttons) {
+        ImGui::SameLine(ImGui::GetCursorPosX() + ImGui::GetContentRegionAvail().x - buttons_w);
+        if (can_update && ImGui::Button("Update", ImVec2(bw, px(28))))
+            m->start_update_cb();
+        if (can_update && show_page) ImGui::SameLine(0, px(th.spacing_sm));
+        if (show_page && ImGui::Button("Release page", ImVec2(bw, px(28))))
+            m->open_url_cb(url);
+    }
+    end_panel();
+    ImGui::Dummy(ImVec2(0, px(th.spacing_sm)));
+}
