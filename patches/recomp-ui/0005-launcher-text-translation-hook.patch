 #include <cstring>
 #include <string>
+#include <unordered_map>
+
+// ---- Launcher text in the player's language (GameInfo.translate) ----------
+// The text passed to the ImGui calls below goes through tr_text, which asks the
+// host for a translation of the part before any "##id" suffix and keeps the
+// suffix, so widget IDs stay stable. Popup names are IDs and stay English.
+static const LauncherModel* g_tr_model = nullptr;
+static const char* tr_text(const char* s) {
+    const LauncherModel* m = g_tr_model;
+    if (s == nullptr || m == nullptr || m->translate == nullptr || m->s.language_index <= 0) return s;
+    const char* hash = std::strstr(s, "##");
+    const std::string key = hash ? std::string(s, size_t(hash - s)) : std::string(s);
+    if (key.empty()) return s;
+    const char* t = m->translate(key.c_str(), m->s.language_index);
+    if (t == nullptr || t == s) return s;
+    if (hash == nullptr) return t;
+    static std::unordered_map<std::string, std::string> with_ids; // nodes keep c_str() stable
+    std::string& slot = with_ids[std::string(t) + hash];
+    if (slot.empty()) slot = std::string(t) + hash;
+    return slot.c_str();
+}
+#define Button(label, ...) Button(tr_text(label), ##__VA_ARGS__)
+#define Checkbox(label, ...) Checkbox(tr_text(label), ##__VA_ARGS__)
+#define Selectable(label, ...) Selectable(tr_text(label), ##__VA_ARGS__)
+#define Text(fmt, ...) Text(tr_text(fmt), ##__VA_ARGS__)
+#define TextColored(c, fmt, ...) TextColored(c, tr_text(fmt), ##__VA_ARGS__)
+#define TextWrapped(fmt, ...) TextWrapped(tr_text(fmt), ##__VA_ARGS__)
+#define TextDisabled(fmt, ...) TextDisabled(tr_text(fmt), ##__VA_ARGS__)
+#define SetTooltip(fmt, ...) SetTooltip(tr_text(fmt), ##__VA_ARGS__)
+#define TextUnformatted(text) TextUnformatted(tr_text(text))
 
