@@ -1527,6 +1610,10 @@ void draw_dashboard(LauncherModel* m, const LauncherTheme& th, int logical_w) {
             ImGui::Dummy(ImVec2(0, gap));
             tpak_p->draw(m, &th);
         }
+        if (m->has_netplay) {
+            ImGui::Dummy(ImVec2(0, gap));
+            panel_netplay_draw(m, th);
+        }
     } else {
         if (game_p) { g_game_fill_h = false; game_p->draw(m, &th); }
         if (game_p && ctrl_p) ImGui::Spacing();
@@ -1534,6 +1621,7 @@ void draw_dashboard(LauncherModel* m, const LauncherTheme& th, int logical_w) {
         // Narrow single-column layout: memcards stack under the controller.
         if (save_p) { ImGui::Spacing(); save_p->draw(m, &th); }
         if (tpak_p) { ImGui::Spacing(); tpak_p->draw(m, &th); }
+        if (m->has_netplay) { ImGui::Spacing(); panel_netplay_draw(m, th); }
     }
 }
 
