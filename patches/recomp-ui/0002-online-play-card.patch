@@ -1271,6 +1271,89 @@ void panel_tpak_draw(LauncherModel* m, const LauncherTheme* th) {
     }
 }
 
+// ---- ONLINE PLAY card (GameInfo.has_netplay; Pokemon Stadium) ---------------
+// Full-width card under the Transfer Pak row: an Off / Host / Join segmented
+// row plus the port and, when joining, the host's address. Edits
+// m->s.netplay_* directly; the host starts the session from them at Play.
+void panel_netplay_draw(LauncherModel* m, const LauncherTheme& th) {
+    if (!begin_panel("netplay", 0, false)) { end_panel(); return; }
+    eyebrow("ONLINE PLAY");
+
+    struct Seg { int mode; const char* label; };
+    static const Seg segs[] = { { 0, "Off" }, { 1, "Host" }, { 2, "Join" } };
+    const float gap = px(4.0f);
+    const float seg_w = px(96.0f);
+    for (int i = 0; i < 3; ++i) {
+        if (i) ImGui::SameLine(0, gap);
+        const bool sel = m->s.netplay_mode == segs[i].mode;
+        ImGui::PushID(i);
+        ImGui::PushStyleColor(ImGuiCol_Button, sel ? col(th.accent) : col(th.control));
+        ImGui::PushStyleColor(ImGuiCol_ButtonHovered, sel ? col(th.accent) : col(th.control_hovered));
+        ImGui::PushStyleColor(ImGuiCol_ButtonActive, col(th.accent));
+        ImGui::PushStyleColor(ImGuiCol_Text, sel ? col(th.accent_text) : col(th.text));
+        if (ImGui::Button(segs[i].label, ImVec2(seg_w, px(28))))
+            m->s.netplay_mode = segs[i].mode;
+        ImGui::PopStyleColor(4);
+        ImGui::PopID();
+    }
+
+    if (m->s.netplay_mode == 2) {
+        ImGui::SameLine(0, px(th.spacing_md));
+        ImGui::SetNextItemWidth(px(220));
+        ImGui::InputTextWithHint("##np_addr", "Host's address, e.g. 203.0.113.5",
+                                 m->s.netplay_address, sizeof(m->s.netplay_address));
+    }
+    if (m->s.netplay_mode != 0) {
+        ImGui::SameLine(0, px(th.spacing_md));
+        ImGui::AlignTextToFramePadding();
+        ImGui::TextColored(col(th.text_muted), "Port");
+        ImGui::SameLine();
+        ImGui::SetNextItemWidth(px(90));
+        if (ImGui::InputInt("##np_port", &m->s.netplay_port, 0, 0)) {
+            if (m->s.netplay_port < 1) m->s.netplay_port = 1;
+            if (m->s.netplay_port > 65535) m->s.netplay_port = 65535;
+        }
+    }
+    if (m->s.netplay_mode == 1) {
+        // The host picks how many players the session waits for.
+        if (m->s.netplay_players < 2 || m->s.netplay_players > 4) m->s.netplay_players = 2;
+        ImGui::SameLine(0, px(th.spacing_md));
+        ImGui::AlignTextToFramePadding();
+        ImGui::TextColored(col(th.text_muted), "Players");
+        for (int n = 2; n <= 4; ++n) {
+            ImGui::SameLine(0, n == 2 ? px(th.spacing_sm) : gap);
+            const bool sel = m->s.netplay_players == n;
+            char label[8];
+            snprintf(label, sizeof(label), "%d##np_pl", n);
+            ImGui::PushStyleColor(ImGuiCol_Button, sel ? col(th.accent) : col(th.control));
+            ImGui::PushStyleColor(ImGuiCol_ButtonHovered, sel ? col(th.accent) : col(th.control_hovered));
+            ImGui::PushStyleColor(ImGuiCol_ButtonActive, col(th.accent));
+            ImGui::PushStyleColor(ImGuiCol_Text, sel ? col(th.accent_text) : col(th.text));
+            if (ImGui::Button(label, ImVec2(px(36), px(28))))
+                m->s.netplay_players = n;
+            ImGui::PopStyleColor(4);
+        }
+    }
+
+    ImGui::Dummy(ImVec2(0, px(4)));
+    if (m->s.netplay_mode == 1) {
+        ImGui::TextWrapped("You're player 1. Forward TCP port %d on your router to this PC, then give "
+                           "the others your public IP address. Press Play to wait for them; the game "
+                           "starts when %d players are in.",
+                           m->s.netplay_port, m->s.netplay_players);
+    } else if (m->s.netplay_mode == 2) {
+        ImGui::TextWrapped("Enter the host's public IP address and press Play. Players get numbers "
+                           "2-4 in the order they join. Everyone needs the same version.");
+    } else {
+        ImGui::TextColored(col(th.text_muted),
+                           "Play friends over the internet: one player hosts, up to three join.");
+    }
+    if (m->s.netplay_mode != 0)
+        ImGui::TextColored(col(th.text_muted),
+                           "Transfer Pak carts stay unplugged in online games for now; use rentals.");
+    end_panel();
+}
+
 // PSX-style 3-way pad-mode selector: Hybrid / Analog / D-Pad segmented row.
