+// PSR: copies `from` over `to` by rewriting `to` in place (truncate + write).
+// std::filesystem::copy_file can refuse to replace a file the process may
+// still write to, e.g. on Android a file in the app's own folder that adb
+// created: the save stayed in the .temp and every save "failed" (2026-11-22).
+static bool overwrite_in_place(const std::filesystem::path& from, const std::filesystem::path& to) {
+    std::ifstream in{from, std::ios_base::binary};
+    if (!in.good()) {
+        return false;
+    }
+    std::ofstream out{to, std::ios_base::binary | std::ios_base::trunc};
+    if (!out.good()) {
+        return false;
+    }
+    out << in.rdbuf();
+    out.flush();
+    return out.good();
+}
+
 bool recomp::finalize_output_file_with_backup(const std::filesystem::path& filepath) {
     std::filesystem::path backup_path{filepath};
     backup_path += backup_suffix;
