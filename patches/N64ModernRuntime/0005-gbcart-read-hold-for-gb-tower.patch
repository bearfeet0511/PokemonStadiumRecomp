+// Hold the reading thread briefly on each cart-memory block read, without
+// yielding to other guest threads, so cart reads take closer to real Transfer
+// Pak time. Stadium's GB Tower preloads ROM banks for a limited time while its
+// Game Boy emulator starts. With instant reads it got through all 44 of
+// Pokemon Red's banks, including the nearly empty bank 44, and then failed
+// ("The Transfer Pak is not set properly", or a hang at the Nintendo logo).
+// At 100us per block the preload stops at bank 43 and Red boots every time.
+// PSR_GBCART_HOLD_US overrides the hold (0 disables it).
+static void cart_read_hold() {
+    static const uint32_t hold_us = [] {
+        const char* e = std::getenv("PSR_GBCART_HOLD_US");
+        return (e != nullptr && e[0] != '\0') ? static_cast<uint32_t>(std::strtoul(e, nullptr, 10)) : 100u;
+    }();
+    if (hold_us == 0) {
+        return;
+    }
+    const auto until = std::chrono::steady_clock::now() + std::chrono::microseconds(hold_us);
+    while (std::chrono::steady_clock::now() < until) {
+    }
+}
