+// Run audio tasks on the submitting thread, so they read RDRAM as it was when
+// the game started them (the RSP runs a task right away on hardware). Queued,
+// they ran later on the SP task thread while game threads kept writing memory
+// the task reads; in Pokemon Stadium that put static on every announcer line
+// (PSR issue #10). The SP task thread still sends completion.
+// PSR_AUDIO_RUN_AT_SUBMIT=0 restores the queued behavior.
+static bool audio_runs_at_submit() {
+    static const bool on = [] {
+        const char* e = std::getenv("PSR_AUDIO_RUN_AT_SUBMIT");
+        return !(e != nullptr && e[0] == '0');
+    }();
+    return on;
+}
