+        // through after a knockback); not blending models at all can't split them.
+        static const bool s_noModelInterp = (std::getenv("PSR_INTERP_MODELS") != nullptr) && (std::getenv("PSR_INTERP_MODELS")[0] == '0');
+        if (s_noModelInterp) {
+            return matchResult;
