index 5f1fcb3..6e729e6 100644
--- a/src/hle/rt64_workload_queue.cpp
+++ b/src/hle/rt64_workload_queue.cpp
@@ -10,7 +10,15 @@
 
 #define ENABLE_HIGH_RESOLUTION_RENDERER 1
 
+#include <atomic>
+#include <chrono>
+
 namespace RT64 {
+    // PSR: GPU time counters (see the timing around the workload's execute/wait).
+    std::atomic<uint64_t> psrGpuWaitUs{0};
+    std::atomic<uint64_t> psrGpuWaitMaxUs{0};
+    std::atomic<uint64_t> psrGpuFrames{0};
+
     static const int ReferenceHeight = 240;
     static const int ReferenceInterlacedHeight = 480;
 
@@ -886,8 +894,17 @@ namespace RT64 {
 
             ext.workloadGraphicsWorker->commandList->end();
             framebufferRenderer->waitForUploaders();
+            const auto gpuStart = std::chrono::steady_clock::now();
             ext.workloadGraphicsWorker->execute();
             ext.workloadGraphicsWorker->wait();
+            {
+                // PSR: GPU time per frame (submit to completion), read by the game's frame log.
+                const uint64_t us = uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - gpuStart).count());
+                psrGpuWaitUs += us;
+                psrGpuFrames += 1;
+                uint64_t prevMax = psrGpuWaitMaxUs.load();
+                while ((us > prevMax) && !psrGpuWaitMaxUs.compare_exchange_weak(prevMax, us)) {}
+            }
             workerMutex.unlock();
 
             // Indicate to the texture cache it's safe to delete the textures if no locks are active.
